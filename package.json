{
    "name": "@norgate-av/genlinx",
    "description": "A CLI utility for NetLinx projects 🚀🚀🚀",
    "version": "2.7.0",
    "license": "MIT",
    "main": "dist/app.js",
    "type": "module",
    "keywords": [
        "netlinx",
        "amx",
        "genlinx"
    ],
    "files": [
        "dist",
        "docs",
        "scripts"
    ],
    "bin": {
        "genlinx": "dist/app.js"
    },
    "man": [
        "docs/genlinx.1"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/Norgate-AV/genlinx.git"
    },
    "bugs": {
        "url": "https://github.com/Norgate-AV/genlinx/issues"
    },
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "commit": "git-cz",
        "clean": "rimraf dist",
        "lint": "tsc --noEmit",
        "pretty:fix": "prettier --write .",
        "prebuild": "pnpm clean",
        "build": "tsup",
        "prestart": "pnpm lint && pnpm build",
        "start": "cross-env NODE_ENV=production node dist/app.js",
        "dev": "nodemon --exec vite-node src/app.ts",
        "doctoc": "doctoc --title '## Contents 📖' README.md",
        "semantic-release": "semantic-release",
        "contrib:add": "all-contributors add",
        "contrib:generate": "all-contributors generate",
        "contrib:check": "all-contributors check",
        "prepare": "husky",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "@commander-js/extra-typings": "^14.0.0",
        "@commitlint/cli": "^20.4.1",
        "@commitlint/config-conventional": "^20.4.1",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/git": "^10.0.1",
        "@types/adm-zip": "^0.5.7",
        "@types/config": "^3.3.5",
        "@types/figlet": "^1.7.0",
        "@types/lodash": "^4.17.23",
        "@types/node": "^25.2.3",
        "all-contributors-cli": "^6.26.1",
        "commitizen": "^4.3.1",
        "conventional-changelog-conventionalcommits": "^9.1.0",
        "cross-env": "^10.1.0",
        "cz-conventional-changelog": "3.3.0",
        "doctoc": "^2.2.1",
        "husky": "^9.1.7",
        "jsdoc": "^4.0.5",
        "lint-staged": "^16.2.7",
        "nodemon": "^3.1.11",
        "prettier": "^3.8.1",
        "rimraf": "^6.1.3",
        "semantic-release": "^25.0.3",
        "terser": "^5.46.0",
        "tsup": "^8.5.1",
        "type-fest": "^5.4.4",
        "typescript": "^5.9.3",
        "vite-node": "^5.3.0",
        "vitest": "^4.0.18"
    },
    "dependencies": {
        "@inquirer/prompts": "^8.2.1",
        "adm-zip": "^0.5.16",
        "chalk": "^5.6.2",
        "commander": "^14.0.3",
        "config": "^4.3.0",
        "console-table-printer": "^2.15.0",
        "cosmiconfig": "^9.0.0",
        "dotenv": "^17.3.1",
        "envalid": "^8.1.1",
        "execa": "^9.6.1",
        "figlet": "^1.10.0",
        "find-up": "8.0.0",
        "listr2": "^10.1.0",
        "lodash": "^4.17.23",
        "mergician": "^2.0.2",
        "node-jq": "^6.3.1",
        "string-builder": "^0.1.8",
        "which": "^6.0.1"
    }
}
